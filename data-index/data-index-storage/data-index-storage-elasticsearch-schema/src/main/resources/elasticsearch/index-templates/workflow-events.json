            "keyword": {
              "type": "keyword"
            }
          }
        },
        "workflowVersion": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "workflowNamespace": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "status": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "startTime": {
          "type": "date"
        },
        "endTime": {
          "type": "date"
        },
        "input": {
