{
  "source": {
    "index": "task-events-*",
    "query": {
      "bool": {
        "should": [
          {
            "range": {
              "@timestamp": {
                "gte": "now-1h"
              }
            }
          },
          {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "lt": "now-1h"
                    }
                  }
                }
              ],
              "must_not": [
                {
                  "term": {
                    "eventType.keyword": "io.serverlessworkflow.task.completed.v1"
                  }
                },
                {
                  "term": {
                    "eventType.keyword": "io.serverlessworkflow.task.faulted.v1"
                  }
                }
              ]
            }
          }
        ],
        "minimum_should_match": 1
      }
    }
  },
  "dest": {
    "index": "task-executions"
  },
  "frequency": "1s",
  "sync": {
    "time": {
      "field": "@timestamp",
      "delay": "0s"
    }
  },
  "pivot": {
    "group_by": {
      "id": {
        "terms": {
          "script": {
            "source": "doc['instanceId.keyword'].value + ':' + doc['taskPosition.keyword'].value"
          }
        }
      }
    },
    "aggregations": {
      "instance_id": {
        "terms": {
          "field": "instanceId.keyword",
          "size": 1
        }
      },
      "taskPosition": {
        "terms": {
          "field": "taskPosition.keyword",
          "size": 1
        }
      },
      "taskName": {
        "terms": {
          "field": "taskName.keyword",
          "size": 1
        }
      },
      "status": {
        "terms": {
          "field": "status.keyword",
          "size": 1,
          "order": {"_key": "desc"}
        }
      },
      "start": {
        "scripted_metric": {
          "init_script": "state.min = null",
          "map_script": "if (params._source.containsKey('startTime') && params._source.startTime != null) { long timeMs = Math.round(params._source.startTime * 1000.0); if (state.min == null || timeMs < state.min) { state.min = Long.valueOf(timeMs) } }",
          "combine_script": "return state.min",
          "reduce_script": "if (params._aggs == null) { return null; } return params._aggs.stream().filter(v -> v != null).min(Long::compare).orElse(null)"
        }
      },
      "end": {
        "scripted_metric": {
          "init_script": "state.max = null",
          "map_script": "if (params._source.containsKey('endTime') && params._source.endTime != null) { long timeMs = Math.round(params._source.endTime * 1000.0); if (state.max == null || timeMs > state.max) { state.max = Long.valueOf(timeMs) } }",
          "combine_script": "return state.max",
          "reduce_script": "if (params._aggs == null) { return null; } return params._aggs.stream().filter(v -> v != null).max(Long::compare).orElse(null)"
        }
      },
      "last_update": {
        "max": {
          "field": "@timestamp"
        }
      }
    }
  }
}
