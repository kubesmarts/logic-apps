{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":dependencyDashboard"
  ],

  // Schedule: Weekly on Monday at 9am UTC (same as Dependabot)
  "schedule": ["before 9am on Monday"],
  "timezone": "UTC",

  // Limit open PRs to avoid overwhelming reviewers
  "prConcurrentLimit": 10,

  // Auto-merge patch updates for non-critical dependencies (optional - remove if you prefer manual review)
  "packageRules": [
    // ========================================================================
    // Maven Dependencies
    // ========================================================================
    {
      "description": "Group Quarkus platform updates together",
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["^io\\.quarkus"],
      "groupName": "Quarkus dependencies",
      "labels": ["dependencies", "java", "quarkus"],
      "commitMessagePrefix": "chore(deps):",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group test dependencies together",
      "matchManagers": ["maven"],
      "matchPackagePatterns": [
        "^org\\.junit",
        "^org\\.assertj",
        "^org\\.testcontainers",
        "^org\\.mockito"
      ],
      "groupName": "Test dependencies",
      "labels": ["dependencies", "java", "test"],
      "commitMessagePrefix": "chore(deps):",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group workflow dependencies together",
      "matchManagers": ["maven"],
      "matchPackagePatterns": ["^io\\.serverlessworkflow"],
      "groupName": "Workflow dependencies",
      "labels": ["dependencies", "java", "workflow"],
      "commitMessagePrefix": "chore(deps):",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Major Maven updates - review carefully",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "java", "major-update"],
      "commitMessagePrefix": "chore(deps):",
      "automerge": false
    },
    {
      "description": "Minor/Patch Maven updates - can auto-merge if tests pass",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "java"],
      "commitMessagePrefix": "chore(deps):",
      "automerge": false  // Set to true if you want auto-merge after CI passes
    },

    // ========================================================================
    // GitHub Actions
    // ========================================================================
    {
      "description": "GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "github-actions"],
      "commitMessagePrefix": "chore(ci):",
      "automerge": false
    },

    // ========================================================================
    // Docker Images
    // ========================================================================
    {
      "description": "Docker image updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "labels": ["dependencies", "docker"],
      "commitMessagePrefix": "chore(docker):",
      "automerge": false
    },
    {
      "description": "Group Vector updates across all files (Maven + Helm)",
      "matchPackageNames": ["timberio/vector"],
      "groupName": "Vector",
      "labels": ["dependencies", "vector"],
      "commitMessagePrefix": "chore(deps):",
      "automerge": false
    },
    {
      "description": "Group Elasticsearch updates across all files (Helm + shell scripts)",
      "matchPackageNames": ["docker.elastic.co/elasticsearch/elasticsearch"],
      "groupName": "Elasticsearch",
      "labels": ["dependencies", "elasticsearch"],
      "commitMessagePrefix": "chore(deps):",
      "automerge": false
    },
    {
      "description": "Group Kafka updates across all files (Helm)",
      "matchPackageNames": ["apache/kafka"],
      "groupName": "Kafka",
      "labels": ["dependencies", "kafka"],
      "commitMessagePrefix": "chore(deps):",
      "automerge": false
    }
  ],

  // ========================================================================
  // Custom Regex Managers - Track non-standard dependencies
  // ========================================================================
  "regexManagers": [
    {
      "description": "Vector image version in Maven properties",
      "fileMatch": ["^data-index/collectors/pom\\.xml$"],
      "matchStrings": [
        "<vector\\.version>(?<currentValue>.*?)</vector\\.version>"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "timberio/vector",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>.+?)(?:-distroless-libc)?$"
    },
    {
      "description": "Vector image version in Helm values",
      "fileMatch": ["^data-index/helm/data-index/values.*\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=docker depName=timberio/vector\\n\\s+tag: \"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "timberio/vector",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>.+?)(?:-distroless-libc)?$"
    },
    {
      "description": "Vector image version in collector example DaemonSets",
      "fileMatch": ["^data-index/collectors/examples/.*/daemonset\\.yaml$"],
      "matchStrings": [
        "image: timberio/vector:(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "timberio/vector",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^(?<version>.+?)(?:-distroless-libc)?$"
    },
    {
      "description": "Elasticsearch image version in Helm values",
      "fileMatch": ["^data-index/helm/data-index/values.*\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=docker depName=docker\\.elastic\\.co/elasticsearch/elasticsearch\\n\\s+tag: \"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.elastic.co/elasticsearch/elasticsearch",
      "versioningTemplate": "docker"
    },
    {
      "description": "Elasticsearch image version in shell scripts and YAML manifests",
      "fileMatch": ["^data-index/scripts/.*\\.(sh|yaml)$"],
      "matchStrings": [
        "image: docker\\.elastic\\.co/elasticsearch/elasticsearch:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.elastic.co/elasticsearch/elasticsearch",
      "versioningTemplate": "docker"
    },
    {
      "description": "Kafka image version in Helm values",
      "fileMatch": ["^data-index/helm/data-index/values.*\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=docker depName=apache/kafka\\n\\s+tag: \"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "apache/kafka",
      "versioningTemplate": "docker"
    }
  ],

  // ========================================================================
  // Maven-specific configuration
  // ========================================================================
  "maven": {
    // Ignore snapshot versions
    "ignoreDeps": ["*-SNAPSHOT"]
  },

  // ========================================================================
  // Vulnerability Alerts
  // ========================================================================
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },

  // ========================================================================
  // PR Configuration
  // ========================================================================
  "prCreation": "immediate",  // Create PRs as soon as updates are found
  "prHourlyLimit": 2,        // Max 2 PRs per hour to avoid spam
  "semanticCommits": "enabled",
  "commitMessageAction": "Update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",

  // ========================================================================
  // Ignore Patterns
  // ========================================================================
  "ignorePaths": [
    "**/node_modules/**",
    "**/target/**",
    "**/.mvn/**"
  ]
}
